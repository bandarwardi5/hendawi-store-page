rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check admin role from profiles/{uid}.role
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── Products (public read, admin write)
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Categories / Brands / Banners (public read, admin write)
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── User profiles
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // owner can update own profile EXCEPT the role field; admins can update anything
      allow update: if (isOwner(uid) && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Orders
    match /orders/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Settings (site-wide single doc)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}